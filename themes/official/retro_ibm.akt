{
  "name": "Retro Ibm",
  "colors": {
    "keyboardBackground": "#FF8B8B83",
    "toolbarBackground": "#FFC5C5C0",
    "keyBackground": "#FFDFDFD8",
    "keyBorder": "#FFB5B5AF",
    "keyText": "#FF2F2F2F",
    "keySubText": "#FF8B0000",
    "accentColor": "#FF000080",
    "accentBg": "#22000080",
    "popupBackground": "#FFDFDFD8",
    "keyHint": "#FF8B0000",
    "keyBackgroundGradient": [
      "#FFDFDFD8",
      "#FF000080"
    ],
    "borderGlowColor": "#FF000080"
  },
  "style": {
    "showKeyBorders": false,
    "showKeyBackgrounds": true,
    "borderGlowRadius": 6.0,
    "keyBackgroundOpacity": 0.35,
    "keyHighlightOpacity": 0.45,
    "swipeTrailWidth": 4.0,
    "swipeTrailBgWidth": 15.0,
    "keyCornerRadius": 0,
    "keyMargins": true
  },
  "transitions": {
    "pressedEnterDuration": 40,
    "pressedExitDuration": 150,
    "pressedScale": 0.95
  },
  "haptics": {
    "sharpness": 0.7,
    "intensityMultiplier": 1.2
  },
  "shaders": {
    "keyBackgroundPressed": {
      "type": "TOUCH_RIPPLE",
      "speed": 2.0,
      "scale": 1.0
    },
    "swipeTrail": {
      "type": "GLOW_TRAIL",
      "speed": 2.0,
      "scale": 1.0
    }
  },
  "typography": {
    "fontFamily": "SYSTEM"
  }
}
