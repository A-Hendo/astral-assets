{
  "name": "Neo Brutalism",
  "colors": {
    "keyboardBackground": "#FFFFF000",
    "toolbarBackground": "#FF000000",
    "keyBackground": "#FFFFFFFF",
    "keyBorder": "#FF000000",
    "keyText": "#FF000000",
    "keySubText": "#99000000",
    "accentColor": "#FF000000",
    "accentBg": "#FF00FF00",
    "popupBackground": "#FFFFFFFF",
    "keyHint": "#99000000",
    "keyBackgroundGradient": [
      "#FFFFFFFF",
      "#FF00FF00"
    ],
    "borderGlowColor": "#FF00FF00"
  },
  "style": {
    "showKeyBorders": false,
    "showKeyBackgrounds": true,
    "borderGlowRadius": 6.0,
    "keyBackgroundOpacity": 0.35,
    "keyHighlightOpacity": 0.45,
    "swipeTrailWidth": 4.0,
    "swipeTrailBgWidth": 15.0,
    "keyCornerRadius": 0,
    "keyMargins": true
  },
  "transitions": {
    "pressedEnterDuration": 40,
    "pressedExitDuration": 150,
    "pressedScale": 0.95
  },
  "haptics": {
    "sharpness": 0.7,
    "intensityMultiplier": 1.2
  },
  "shaders": {
    "keyBackgroundPressed": {
      "type": "TOUCH_RIPPLE",
      "speed": 2.0,
      "scale": 1.0
    },
    "swipeTrail": {
      "type": "GLOW_TRAIL",
      "speed": 2.0,
      "scale": 1.0
    }
  },
  "typography": {
    "fontFamily": "SYSTEM"
  }
}
