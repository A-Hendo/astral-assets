{
  "name": "Glassmorphism",
  "colors": {
    "keyboardBackground": "#1AFFFFFF",
    "toolbarBackground": "#26FFFFFF",
    "keyBackground": "#1F999999",
    "keyBorder": "#26FFFFFF",
    "keyText": "#FFFFFFFF",
    "keySubText": "#80FFFFFF",
    "accentColor": "#FFFFFFFF",
    "accentBg": "#CC007AFF",
    "popupBackground": "#FF1C1C1E",
    "keyHint": "#80FFFFFF",
    "keyBackgroundGradient": [
      "#22FFFFFF",
      "#0AFFFFFF"
    ],
    "borderGlowColor": "#FFFFFF"
  },
  "style": {
    "showKeyBorders": false,
    "showKeyBackgrounds": true,
    "borderGlowRadius": 5.0,
    "keyBackgroundOpacity": 0.15,
    "keyHighlightOpacity": 0.7,
    "swipeTrailWidth": 4.0,
    "swipeTrailBgWidth": 15.0,
    "keyCornerRadius": 12,
    "keyMargins": true
  },
  "transitions": {
    "pressedEnterDuration": 40,
    "pressedExitDuration": 150,
    "pressedScale": 0.95
  },
  "haptics": {
    "sharpness": 0.7,
    "intensityMultiplier": 1.2
  },
  "shaders": {
    "keyBackgroundPressed": {
      "type": "LIQUID_CHROME",
      "speed": 0.8,
      "scale": 1.5
    },
    "swipeTrail": {
      "type": "GLOW_TRAIL",
      "speed": 2.0,
      "scale": 1.0
    }
  },
  "typography": {
    "fontFamily": "SYSTEM"
  }
}
