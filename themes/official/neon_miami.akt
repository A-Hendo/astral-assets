{
  "name": "Neon Miami",
  "colors": {
    "keyboardBackground": "#FF0D0E15",
    "toolbarBackground": "#FF1A1C29",
    "keyBackground": "#22FF007F",
    "keyBorder": "#FFEA00D9",
    "keyText": "#FFFFFFFF",
    "keySubText": "#FF00F0FF",
    "accentColor": "#FF00F0FF",
    "accentBg": "#3300F0FF",
    "popupBackground": "#FF1A1C29",
    "keyHint": "#FF00F0FF",
    "keyBackgroundGradient": [
      "#FFFF007F",
      "#FF00FFFF"
    ],
    "borderGlowColor": "#00F0FF"
  },
  "style": {
    "showKeyBorders": false,
    "showKeyBackgrounds": true,
    "borderGlowRadius": 8.0,
    "keyBackgroundOpacity": 0.4,
    "keyHighlightOpacity": 0.5,
    "swipeTrailWidth": 4.0,
    "swipeTrailBgWidth": 15.0,
    "keyCornerRadius": 24,
    "keyMargins": true
  },
  "transitions": {
    "pressedEnterDuration": 40,
    "pressedExitDuration": 150,
    "pressedScale": 0.95
  },
  "haptics": {
    "sharpness": 0.7,
    "intensityMultiplier": 1.2
  },
  "shaders": {
    "keyBackgroundPressed": {
      "type": "TOUCH_RIPPLE",
      "speed": 2.0,
      "scale": 1.0
    },
    "swipeTrail": {
      "type": "GLOW_TRAIL",
      "speed": 2.0,
      "scale": 1.0
    }
  },
  "typography": {
    "fontFamily": "SYSTEM"
  }
}
